{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2SnapshotPermissions",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DescribeInstances",
        "ec2:CreateSnapshots",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots",
        "ec2:CreateVolume",
        "ec2:CopySnapshot",
        "ec2:CreateTags"
      ],
      "Resource": "*"
    }
  ]
}
